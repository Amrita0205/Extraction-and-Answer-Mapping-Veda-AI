# Copy to api/.env and fill in. api/.env is gitignored — never commit a key.
# A free key comes from https://aistudio.google.com/apikey and starts with "AIza".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Set AI_PROVIDER=ollama for local vision inference. Install Ollama and run:
# ollama pull gemma3:12b
AI_PROVIDER=gemini
OLLAMA_MODEL=gemma3:12b
OLLAMA_BASE_URL=http://localhost:11434

# Comma-separated origins allowed to call this API. "*" is fine locally;
# set it to the deployed web URL in production.
ALLOWED_ORIGINS=*
